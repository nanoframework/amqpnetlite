<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>AMQPNetLite.nanoFramework</id>
    <title>AMQP.Net Lite for nanoFramework</title>
    <version>0.0.0</version>
    <authors>xinchen</authors>
    <license type="expression">Apache-2.0</license>
    <projectUrl>https://github.com/Azure/amqpnetlite</projectUrl>
    <repository type="git" url="https://github.com/nanoframework/amqpnetlite" commit="$commit$" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      This is a lightweight AMQP library for .Net nanoFramework. A more compact version
      is available in the AMQPNetMicro.nanoFramework package.
    </description>
    <readme>docs\README.md</readme>
    <copyright>Copyright 2014</copyright>
    <tags>AMQP net netmf nf nanoframework</tags>
    <dependencies>
      <group targetFramework=".NETnanoFramework1.0">
        <dependency id="nanoFramework.CoreLibrary" version="2.0.0-preview.67" />
        <dependency id="nanoFramework.ResourceManager" version="2.0.0-preview.14" />
        <dependency id="nanoFramework.Runtime.Events" version="2.0.0-preview.19" />
        <dependency id="nanoFramework.System.Collections" version="2.0.0-preview.24" />
        <dependency id="nanoFramework.System.Math" version="2.0.0-preview.36" />
        <dependency id="nanoFramework.System.Net" version="2.0.0-preview.52" />
        <dependency id="nanoFramework.System.Text" version="2.0.0-preview.37" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="README.md" target="docs\" />
    <file src="nanoFramework\Amqp.nanoFramework\bin\Release\Amqp.nanoFramework.*" target="lib\netnano1.0" />
  </files>
</package>